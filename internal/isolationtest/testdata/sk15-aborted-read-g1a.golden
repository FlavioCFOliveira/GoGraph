10|20
(1 row)
step s1rb: ROLLBACK
step s3r2: MATCH (n:H {name:'a'}) RETURN n.v AS a
a 
--
10
(1 row)
step s2r2: MATCH (x:H {name:'a'}), (y:H {name:'b'}) RETURN x.v AS a, y.v AS b
a |b 
--+--
10|20
(1 row)
step s1dr: <vacuum drain>
step s3r3: MATCH (n:H {name:'a'}) RETURN n.v AS a
a 
--
10
(1 row)
step s2c: COMMIT
final final: MATCH (x:H {name:'a'}), (y:H {name:'b'}) RETURN x.v AS a, y.v AS b
a |b 
--+--
10|20
(1 row)

starting permutation: s2r1 s1u s3r1 s1rb s3r2 s1dr s3r3 s2r2 s2c
step s2r1: MATCH (x:H {name:'a'}), (y:H {name:'b'}) RETURN x.v AS a, y.v AS b
a |b 
--+--
10|20
(1 row)
step s1u: MATCH (n:H {name:'a'}) SET n.v = 101 RETURN n.v AS a
