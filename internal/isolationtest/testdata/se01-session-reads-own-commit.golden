spec se01-session-reads-own-commit: 2 sessions, 7 permutations
# SE01. s1 commits x.v = 1 in an autocommit statement and then x.v = 2 in an explicit
# transaction, reading x through its own cypher.Session after each; s2 reads x
# sessionless (Engine.RunInTx). s1 sees each of its commits immediately (F11,
# docs/isolation-design.md:189).

starting permutation: s1w s1r s1b s1w2 s1c s1r2 s2r
step s1w: MATCH (n:Item {name:'x'}) SET n.v = 1 RETURN n.v AS v
v
