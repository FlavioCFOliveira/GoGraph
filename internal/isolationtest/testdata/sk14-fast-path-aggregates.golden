spec sk14-fast-path-aggregates: 2 sessions, 21 permutations
# SK14. s1 answers count(n) and count(n:L) through the count fast path and through a
# filtered scan, inside one transaction; s2 creates one :L node and deletes another,
# open and then committed. The fast path must equal the scan, at s1's snapshot, in
# every interleaving.

starting permutation: s1fa s1sa s1fl s1sl s1c s2w s2c
step s1fa: MATCH (n) RETURN count(n) AS c
c
