spec sk13-snapshot-at-begin: 2 sessions, 4 permutations
# SK13. s1 BEGINs; s2 creates an :L node in autocommit; s1 then reads for the first
# time. s1 sees the node only if it was committed BEFORE s1's BEGIN: GoGraph takes
# the snapshot at BEGIN (F6). InnoDB's plain START TRANSACTION takes it at the first
# read instead, and would see it; WITH CONSISTENT SNAPSHOT matches GoGraph.

starting permutation: s1b s1r s1c s2w
