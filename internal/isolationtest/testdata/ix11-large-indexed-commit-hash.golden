spec ix11-large-indexed-commit-hash: 3 sessions, 3 permutations
# IX11, hash index (Turso tests.rs:4940, :5550; MIT). s1 re-values s on all 1 100
# :L nodes in one transaction, each to its successor's value, and commits. s2 is a
# read-only transaction pinned at BEGIN; s3 reads in autocommit statements. The equality seek of 'v0' counts 1 before
# the rewrite and 0 after; of 'v1100', 0 before and 1 after.
# Every seek equals its own scan at every instant: the old counts before the
# publish, the new counts after it, never a mix (a seek declines to the scan while
# the index cannot prove the reader's instant, F12).

starting permutation: s2o s1w s3o s2n s3n s2m s3m s1c
step s2o: MATCH (n:L {s:'v0'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v0' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
step s1w: MATCH (n:L) SET n.s = 'v' + toString(n.k / 2 + 1) RETURN count(n) AS rewritten
rewritten
---------
1100     
(1 row)
step s3o: MATCH (n:L {s:'v0'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v0' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
step s2n: MATCH (n:L {s:'v1100'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v1100' RETURN seek, count(m) AS scan
seek|scan
----+----
0   |0   
(1 row)
step s3n: MATCH (n:L {s:'v1100'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v1100' RETURN seek, count(m) AS scan
seek|scan
----+----
0   |0   
(1 row)
step s2m: MATCH (n:L) RETURN sum(CASE WHEN n.s = 'v' + toString(n.k / 2 + 1) THEN 1 ELSE 0 END) AS rewritten, count(n) AS total
rewritten|total
---------+-----
0        |1100 
(1 row)
step s3m: MATCH (n:L) RETURN sum(CASE WHEN n.s = 'v' + toString(n.k / 2 + 1) THEN 1 ELSE 0 END) AS rewritten, count(n) AS total
rewritten|total
---------+-----
0        |1100 
(1 row)
step s1c: COMMIT
final fo: MATCH (n:L {s:'v0'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v0' RETURN seek, count(m) AS scan
seek|scan
----+----
0   |0   
(1 row)
final fn: MATCH (n:L {s:'v1100'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v1100' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
final fm: MATCH (n:L) RETURN sum(CASE WHEN n.s = 'v' + toString(n.k / 2 + 1) THEN 1 ELSE 0 END) AS rewritten, count(n) AS total
rewritten|total
---------+-----
1100     |1100 
(1 row)

