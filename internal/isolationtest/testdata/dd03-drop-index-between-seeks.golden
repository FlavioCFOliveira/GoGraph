spec dd03-drop-index-between-seeks: 2 sessions, 6 permutations
# DD03. Hash index on (:L).s over 1 100 nodes. s1 reads 'v7' through the seek, moves
# n7 to 'zzz', and reads 'zzz' and 'v7' again, inside one transaction; s2 drops the
# index in an autocommit statement. A read after the drop falls back to a scan with
# the same answer, and no read fails: seek = scan in every step.

starting permutation: s1r s1w s1r2 s1r3 s1c s2drop
step s1r: MATCH (n:L {s:'v7'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v7' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
step s1w: MATCH (n:L {name:'n7'}) SET n.s = 'zzz' RETURN n.s AS s
s    
-----
"zzz"
(1 row)
step s1r2: MATCH (n:L {s:'zzz'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'zzz' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
step s1r3: MATCH (n:L {s:'v7'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v7' RETURN seek, count(m) AS scan
seek|scan
----+----
0   |0   
(1 row)
step s1c: COMMIT
step s2drop: DROP INDEX l_s
final fzzz: MATCH (n:L {s:'zzz'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'zzz' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
final fv7: MATCH (n:L {s:'v7'}) WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.s + '' = 'v7' RETURN seek, count(m) AS scan
seek|scan
----+----
0   |0   
(1 row)

