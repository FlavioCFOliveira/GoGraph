step s1r: MATCH (n:L) WHERE n.a = 1 AND n.b = 2 WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE m.a + 0 = 1 AND m.b + 0 = 2 RETURN seek, count(m) AS scan
