spec sk10-write-skew-hash-seek: 2 sessions, 20 permutations
# SK10, hash equality. SK01 write skew with the on-call count read through an index
# seek and, in the same statement, through a scan of the same predicate. The skew
# is permitted (both commit), and the seek must equal the scan in every step.

starting permutation: s1r s1w s1c s2r s2w s2c
step s1r: MATCH (d:Doctor) WHERE d.oncall = 1 WITH count(d) AS seek OPTIONAL MATCH (e:Doctor) WHERE e.oncall + 0 = 1 RETURN seek, count(e) AS scan
seek|scan
----+----
2   |2   
(1 row)
step s1w: MATCH (d:Doctor {name:'alice'}) SET d.oncall = 0 RETURN d.name AS who
who    
-------
"alice"
(1 row)
step s1c: COMMIT
step s2r: MATCH (d:Doctor) WHERE d.oncall = 1 WITH count(d) AS seek OPTIONAL MATCH (e:Doctor) WHERE e.oncall + 0 = 1 RETURN seek, count(e) AS scan
seek|scan
----+----
2   |2   
(1 row)
step s2w: MATCH (d:Doctor {name:'bob'}) SET d.oncall = 0 RETURN d.name AS who
who  
-----
"bob"
(1 row)
step s2c: COMMIT
final final: MATCH (d:Doctor) WHERE d.oncall = 1 RETURN count(d) AS oncall
oncall
------
0     
(1 row)

