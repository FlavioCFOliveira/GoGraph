step s1c: lpg: Session.EndVersionedTx
step s2w1: lpg: SetNodeProperty(b, v, v + 1)
step s2w2: lpg: SetNodeProperty(b, v, v + 1)
step s2c: lpg: Session.EndVersionedTx
