spec ab06-create-delete-recreate-rollback: 2 sessions, 6 permutations
# AB06, ROLLBACK arm. In one transaction s1 creates z (v = 1), deletes it, creates it
# again (v = 2) and reads it, then ends; s2 counts z in an autocommit statement. On
# COMMIT z is visible once with v = 2; on ROLLBACK it was never visible.

starting permutation: s1c1 s1d s1c2 s1r s1rb s2r
step s1c1: CREATE (n:L {name:'z', v:1}) RETURN n.v AS v
v
-
1
(1 row)
step s1d: MATCH (n:L {name:'z'}) DETACH DELETE n RETURN count(*) AS deleted
deleted
-------
1      
(1 row)
step s1c2: CREATE (n:L {name:'z', v:2}) RETURN n.v AS v
v
