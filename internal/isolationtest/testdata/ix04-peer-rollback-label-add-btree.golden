spec ix04-peer-rollback-label-add-btree: 2 sessions, 10 permutations
# IX04 (#2931), btree index, prefix seek. n33 loses :L in a committed statement. s1 opens and sets
# n33.s = 'v999p' (the 'polluted' value of #2931, inside the btree's value domain);
# s2 adds :L back in an autocommit statement; s1 rolls back and the vacuum is
# drained (H1). The label add must index n33 under its COMMITTED value 'v33', never
# under s1's uncommitted 'v999p', so seek = scan for both values in every step and
# after the run (F12).

starting permutation: s1w s1rb s1dr s2l s2v s2p
step s1w: MATCH (n {name:'n33'}) SET n.s = 'v999p' RETURN n.s AS s
s      
-------
"v999p"
(1 row)
step s1rb: ROLLBACK
step s1dr: <vacuum drain>
step s2l: MATCH (n {name:'n33'}) SET n:L RETURN n.name AS name
name 
-----
"n33"
(1 row)
step s2v: MATCH (n:L) WHERE n.s STARTS WITH 'v33' WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE left(m.s, size('v33')) = 'v33' RETURN seek, count(m) AS scan
seek|scan
----+----
11  |11  
(1 row)
step s2p: MATCH (n:L) WHERE n.s STARTS WITH 'v999' WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE left(m.s, size('v999')) = 'v999' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)
final fv: MATCH (n:L) WHERE n.s STARTS WITH 'v33' WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE left(m.s, size('v33')) = 'v33' RETURN seek, count(m) AS scan
seek|scan
----+----
11  |11  
(1 row)
final fp: MATCH (n:L) WHERE n.s STARTS WITH 'v999' WITH count(n) AS seek OPTIONAL MATCH (m:L) WHERE left(m.s, size('v999')) = 'v999' RETURN seek, count(m) AS scan
seek|scan
----+----
1   |1   
(1 row)

