spec hz02-autocommit-read-releases-slot: 2 sessions, 15 permutations
# HZ02. s1 opens a read-only transaction and reads the number of registered
# snapshots, then commits and reads it again; s2 runs an autocommit read and then
# reads the number. An autocommit read holds no slot after it returns; the open read
# transaction holds exactly one.

starting permutation: s1b s1p s1c s1p2 s2r s2p
