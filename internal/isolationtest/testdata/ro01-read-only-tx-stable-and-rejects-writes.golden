spec ro01-read-only-tx-stable-and-rejects-writes: 2 sessions, 6 permutations
# RO01. s1 is a read-only transaction: it reads x, attempts a SET and a CREATE INDEX,
# reads x again and commits; s2 sets x.v = 2 in an autocommit statement. Both reads of
# s1 return v = 0 (F6); the SET and the DDL are ErrWriteInReadOnlyTx and apply nothing
# (F9).

starting permutation: s1r s1w s1ddl s1r2 s1c s2w
step s1r: MATCH (n:Item {name:'x'}) RETURN n.v AS v
