spec mg09-delete-recreate-same-tx: 2 sessions, 4 permutations
# MG09. UNIQUE on (:K).k, one node k='u'. Deleting a UNIQUE value and creating it
# again must leave exactly one holder, never two and never none.
# (a) s1 deletes k='u' and re-creates it in ONE transaction (fix 3b7bec2f); s2
# creates k='u' in an autocommit statement. s2 meets the committed value or s1's
# reservation in every interleaving.

starting permutation: s1d s1r s1c s2r
step s1d: MATCH (n:K {k:'u'}) DELETE n RETURN count(*) AS deleted
deleted
-------
1      
(1 row)
step s1r: CREATE (n:K {k:'u', v:'s1'}) RETURN n.v AS v
v   
----
"s1"
(1 row)
step s1c: COMMIT
step s2r: CREATE (n:K {k:'u', v:'s2'}) RETURN n.v AS v
ERROR: exec: constraint violation: UNIQUE constraint on (K).k: value "u" already exists
final final: MATCH (n:K) RETURN n.k AS k, n.v AS v ORDER BY k, v
k  |v   
---+----
"u"|"s1"
(1 row)

starting permutation: s1d s1r s2r s1c
step s1d: MATCH (n:K {k:'u'}) DELETE n RETURN count(*) AS deleted
deleted
-------
1      
(1 row)
step s1r: CREATE (n:K {k:'u', v:'s1'}) RETURN n.v AS v
v   
----
"s1"
(1 row)
step s2r: CREATE (n:K {k:'u', v:'s2'}) RETURN n.v AS v
ERROR: exec: constraint violation: UNIQUE constraint on (K).k: value "u" already exists
step s1c: COMMIT
final final: MATCH (n:K) RETURN n.k AS k, n.v AS v ORDER BY k, v
k  |v   
---+----
"u"|"s1"
(1 row)

starting permutation: s1d s2r s1r s1c
step s1d: MATCH (n:K {k:'u'}) DELETE n RETURN count(*) AS deleted
deleted
-------
1      
(1 row)
step s2r: CREATE (n:K {k:'u', v:'s2'}) RETURN n.v AS v
ERROR: exec: constraint violation: UNIQUE constraint on (K).k: value "u" already exists
step s1r: CREATE (n:K {k:'u', v:'s1'}) RETURN n.v AS v
v   
----
"s1"
(1 row)
step s1c: COMMIT
final final: MATCH (n:K) RETURN n.k AS k, n.v AS v ORDER BY k, v
k  |v   
---+----
"u"|"s1"
(1 row)

starting permutation: s2r s1d s1r s1c
step s2r: CREATE (n:K {k:'u', v:'s2'}) RETURN n.v AS v
ERROR: exec: constraint violation: UNIQUE constraint on (K).k: value "u" already exists
