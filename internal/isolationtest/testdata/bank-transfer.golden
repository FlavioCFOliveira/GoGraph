spec bank-transfer: 2 sessions, 20 permutations
# Conservation under concurrent transfer — the deterministic counterpart of
# examples/27_concurrent_txn, and of the torn-total sightings rmp #2333 could not
# reproduce. s1 moves 10 from X to Y inside ONE transaction; s2 reads the total in
# a transaction of its own. Snapshot isolation requires that s2 observe ALL of s1
# or NONE of it, so EVERY interleaving must report a total of 100. A transcript
# line showing 90 or 110 is a torn read and an isolation defect.

starting permutation: s1dx s1cy s1c s2t s2t2 s2c
step s1dx: MATCH (a:Account {id:'X'}) SET a.bal = a.bal - 10 RETURN a.bal AS bal
bal
---
40 
(1 row)
step s1cy: MATCH (a:Account {id:'Y'}) SET a.bal = a.bal + 10 RETURN a.bal AS bal
bal
---
60 
(1 row)
step s1c: COMMIT
step s2t: MATCH (a:Account) RETURN sum(a.bal) AS total
total
-----
100  
(1 row)
step s2t2: MATCH (a:Account) RETURN sum(a.bal) AS total
total
-----
100  
(1 row)
step s2c: COMMIT

