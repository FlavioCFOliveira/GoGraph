spec ab03-refused-statement-then-continue-lpg: 2 sessions, 5 permutations
# AB03 through the lpg API. s1 reads x.v, writes x.v = 3, reads x.v again and ends
# its transaction; s2 writes x.v = 2 in its own transaction. A refused write dooms s1:
# its read stays at its snapshot and its commit returns the conflict.

starting permutation: s1r s1w s1r2 s1c s2w
step s1r: lpg: read x.v
x.v
---
0  
(1 row)
step s1w: lpg: SetNodeProperty(x, v, 3)
step s1r2: lpg: read x.v
x.v
---
3  
(1 row)
step s1c: lpg: Session.EndVersionedTx
step s2w: lpg: SetNodeProperty(x, v, 2)
final final: MATCH (n:Item {name:'x'}) RETURN n.v AS v
v
-
2
(1 row)

starting permutation: s1r s1w s1r2 s2w s1c
step s1r: lpg: read x.v
x.v
---
0  
(1 row)
step s1w: lpg: SetNodeProperty(x, v, 3)
step s1r2: lpg: read x.v
x.v
---
3  
(1 row)
step s2w: lpg: SetNodeProperty(x, v, 2)
ERROR: serialization conflict
step s1c: lpg: Session.EndVersionedTx
final final: MATCH (n:Item {name:'x'}) RETURN n.v AS v
v
-
3
(1 row)

starting permutation: s1r s1w s2w s1r2 s1c
step s1r: lpg: read x.v
x.v
---
0  
(1 row)
step s1w: lpg: SetNodeProperty(x, v, 3)
step s2w: lpg: SetNodeProperty(x, v, 2)
ERROR: serialization conflict
step s1r2: lpg: read x.v
x.v
---
3  
(1 row)
step s1c: lpg: Session.EndVersionedTx
final final: MATCH (n:Item {name:'x'}) RETURN n.v AS v
v
-
3
(1 row)

starting permutation: s1r s2w s1w s1r2 s1c
step s1r: lpg: read x.v
x.v
---
0  
(1 row)
step s2w: lpg: SetNodeProperty(x, v, 2)
step s1w: lpg: SetNodeProperty(x, v, 3)
ERROR: serialization conflict
step s1r2: lpg: read x.v
x.v
---
0  
(1 row)
step s1c: lpg: Session.EndVersionedTx
ERROR: serialization conflict
final final: MATCH (n:Item {name:'x'}) RETURN n.v AS v
v
-
2
(1 row)

starting permutation: s2w s1r s1w s1r2 s1c
step s2w: lpg: SetNodeProperty(x, v, 2)
step s1r: lpg: read x.v
x.v
---
0  
(1 row)
step s1w: lpg: SetNodeProperty(x, v, 3)
ERROR: serialization conflict
step s1r2: lpg: read x.v
x.v
---
