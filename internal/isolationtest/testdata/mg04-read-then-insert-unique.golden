spec mg04-read-then-insert-unique: 2 sessions, 20 permutations
# MG04. UNIQUE on (:K).k. Each transaction reads k=42 (none), then creates it. The
# second CREATE meets the first's reservation or committed value and is a
# ConstraintViolation at the statement; exactly one node commits in every
# interleaving. PostgreSQL SERIALIZABLE waits and then raises a serialization
# failure.

starting permutation: s1r s1w s1c s2r s2w s2c
step s1r: MATCH (n:K {k:42}) RETURN count(n) AS c
c
-
0
(1 row)
step s1w: CREATE (n:K {k:42, v:'s1'}) RETURN n.v AS v
v   
----
"s1"
(1 row)
step s1c: COMMIT
step s2r: MATCH (n:K {k:42}) RETURN count(n) AS c
c
-
0
(1 row)
step s2w: CREATE (n:K {k:42, v:'s2'}) RETURN n.v AS v
ERROR: exec: constraint violation: UNIQUE constraint on (K).k: value 42 already exists
step s2c: COMMIT
ERROR: cypher: transaction poisoned by a prior failed Exec statement — call Rollback
final final: MATCH (n:K) RETURN n.k AS k, n.v AS v ORDER BY k, v
k |v   
--+----
42|"s1"
(1 row)

